FROM mcr.microsoft.com/playwright:v1.58.0-noble@sha256:35c7d48b4ccaf3aca5018f5f1bf7f50c7da7d61d176c530741f4f2e9ca336c34

WORKDIR /app

# required by the e2e test code
RUN yarn add "@playwright/test@^1.58.0" "dotenv@^16.3.1"

ENV E2E_BASE_URL="http://localhost:3000"

ENV TZ=Europe/Madrid

ENTRYPOINT ["npx", "playwright", "test", "-c", "e2e/config/playwright.config.ci.ts"]
