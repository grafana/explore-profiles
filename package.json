{
  "name": "pyroscope-app-plugin",
  "version": "2.1.1",
  "description": "Grafana Pyroscope app plugin (profiles)",
  "license": "AGPL-3.0-only",
  "author": "Grafana",
  "scripts": {
    "build": "webpack -c webpack.config.ts --env production",
    "predev": "rm -rf node_modules/.cache",
    "dev": "webpack -w -c webpack.config.ts --env development",
    "docs:dev": "make -C docs docs",
    "e2e:ci": " docker run --network host -v $(pwd)/e2e:/app/e2e -v $(pwd)/src:/app/src pyroscope-app-plugin-e2e:latest",
    "e2e:ci:fast": "docker run --network host -v $(pwd)/e2e:/app/e2e -v $(pwd)/src:/app/src pyroscope-app-plugin-e2e:latest --max-failures=1 --workers=3",
    "e2e:ci:prepare": "docker build --progress=auto -t pyroscope-app-plugin-e2e:latest -f Dockerfile.plugin.e2e .",
    "e2e:ci:server:down": "docker compose down",
    "e2e:ci:server:up": "docker compose -f docker-compose.e2e.yaml up --build -d",
    "e2e:ci:server:up:react19": "GRAFANA_VERSION=dev-preview-react19 GRAFANA_IMAGE=grafana-enterprise GF_FEATURE_TOGGLES_ENABLE=metricsFromProfiles,react19 docker compose -f docker-compose.e2e.yaml up --build -d",
    "e2e:local": "playwright test -c e2e/config/playwright.config.local.ts",
    "e2e:local:codegen": "playwright codegen",
    "e2e:local:prepare": "pnpm exec playwright install --with-deps chromium",
    "e2e:local:server": "docker compose down --remove-orphans && docker compose -f docker-compose.e2e.yaml up --build --abort-on-container-exit",
    "e2e:local:watch": "pnpm run e2e:local --ui",
    "format:fix": "prettier --write .",
    "generate:pyroscope-api": "pnpm exec buf generate",
    "i18n-extract": "i18next-cli extract",
    "i18n-extract-check": "i18next-cli extract --ci",
    "knip": "knip",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix && prettier --write --list-different .",
    "server": "docker compose down --remove-orphans && docker compose up --build --abort-on-container-exit",
    "server:local": "docker compose down --remove-orphans && docker compose -f docker-compose.local.yaml up --build --abort-on-container-exit",
    "server:react19": "GRAFANA_VERSION=dev-preview-react19 GRAFANA_IMAGE=grafana-enterprise GF_FEATURE_TOGGLES_ENABLE=metricsFromProfiles,react19 docker compose -f ./docker-compose.yaml up --build",
    "server:remote": "docker compose down --remove-orphans && docker compose -f docker-compose.remote.yaml up --build --abort-on-container-exit",
    "server:static": "docker compose down --remove-orphans && docker compose -f docker-compose.e2e.yaml up --build --abort-on-container-exit",
    "sign": "pnpm dlx @grafana/sign-plugin@latest",
    "start": "pnpm install --frozen-lockfile --ignore-scripts && pnpm dev",
    "tdd": "jest --watch --onlyChanged",
    "test": "jest --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4 --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.3",
    "@emotion/css": "11.10.6",
    "@grafana/assistant": "0.1.25",
    "@grafana/data": "13.1.0",
    "@grafana/faro-web-sdk": "2.7.1",
    "@grafana/flamegraph": "13.1.0",
    "@grafana/i18n": "13.1.0",
    "@grafana/llm": "1.0.9",
    "@grafana/react-data-grid": "7.0.0-beta.57",
    "@grafana/runtime": "13.1.0",
    "@grafana/scenes": "7.4.0",
    "@grafana/schema": "13.1.0",
    "@grafana/ui": "13.1.0",
    "@openfeature/ofrep-web-provider": "^0.4.1",
    "@openfeature/react-sdk": "^1.2.0",
    "@react-aria/utils": "^3.25.3",
    "@tanstack/react-query": "5.100.11",
    "compression-streams-polyfill": "^0.1.7",
    "file-saver": "^2.0.5",
    "markdown-to-jsx": "^7.3.2",
    "p-limit": "^6.1.0",
    "protobufjs": "^8.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.54.2",
    "react-inlinesvg": "4.2.0",
    "react-router-dom": "^6.30.3",
    "react-use": "^17.6.0",
    "rxjs": "7.8.2",
    "semver": "7.8.0",
    "tslib": "2.5.3",
    "xstate": "^4.38.3"
