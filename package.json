    "eslint-plugin-jsdoc": "62.8.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-sonarjs": "4.0.2",
    "eslint-webpack-plugin": "5.0.3",
    "fork-ts-checker-webpack-plugin": "8.0.0",
