    "@types/lodash": "4.17.24",
    "@types/node": "22.19.15",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/semver": "7.7.1",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "6.11.0",
    "dotenv": "16.6.1",
    "eslint": "9.39.4",
